  ];

  const THEME_WORDS = {
    demon: [
      { word: "RUMI", clue: "Purple HUNTR/X hero", emoji: "💜", tier: 0 },
      { word: "MIRA", clue: "Pink HUNTR/X hero", emoji: "💗", tier: 0 },
      { word: "ZOEY", clue: "Blue HUNTR/X hero", emoji: "💙", tier: 0 },
